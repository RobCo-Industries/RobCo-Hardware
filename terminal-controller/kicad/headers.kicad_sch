			(justify left bottom)
		)
		(uuid "d5f8c03a-da6a-5a9d-8911-88b2c83b7ba0")
	)
	(text "No resistors. A relay module input or a\nlogic input only, never a coil or a lamp.\nAt reset GPIO 4 has a pull-up and\nGPIO 16, 23, 24 a pull-down (typical, check).\nAn active-high module on GPIO 4 can switch\non during boot: use it for active-low ones."
		(exclude_from_sim no)
		(at 106.68 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "db1789e7-29e6-51d9-9076-ef29b0ccb5e7")
	)
