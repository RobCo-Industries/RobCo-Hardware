	(text "R40 to R45: 1 kOhm limit a cable fault on a rail to 3.3 mA.\nA pressed button reads 3.3 V x 1 / (50 + 1) = 0.065 V.\nR50 to R55 not fitted: for a BCM2711, not supported.\nR59: a short on pin 9 draws 33 mA; it feeds a panel LED only.\nNo dial: UOS has six buttons. GPIO 16, 23, 24 go to J7."
		(exclude_from_sim no)
		(at 17.78 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "488fbbf3-1a66-5e91-85c1-7ecfc988f0a2")
	)
