	(text "Odd pins left, even pins right.\nPins 19, 21, 23, 24 and 26 are SPI0:\nnot connected, kept for the software.\nAn SPI display added here must not use\nGPIO 25 (ARM) or 4 as D/C or reset.\nPin map and net names: spec/pins.yaml.\nThe pin check compares this sheet with it."
		(exclude_from_sim no)
		(at 17.78 111.76 0)
