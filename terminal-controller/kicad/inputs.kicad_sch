	(text "Resistor to fit per field voltage"
		(exclude_from_sim no)
		(at 204.47 73.025 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.3333)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fe5197a3-bc6a-5708-85a2-d7990e2994bd")
	)
	(text "5 V on +V_S: R60 to R67 = 1 kOhm, 0.5 W.\n12 V on +V_S: R60 to R67 = 2.2 kOhm, 0.5 W.\n24 V on +V_S: R60 to R67 = 2.2 kOhm, 0.5 W.\nEvery voltage: R70 to R77 = 47 kOhm."
		(exclude_from_sim no)
		(at 208.28 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7497e495-0bdd-58db-bfc0-dc4197c35623")
	)
	(text "Never put 24 V on 1 kOhm inputs: 23.9 mA x\n23.9 V = 0.57 W, above the 0.5 W rating.\nAt 24 V, 2.2 kOhm dissipates 0.26 W: keep\nR60 to R67 at least 2 mm apart.\nMark the fitted value on the board."
		(exclude_from_sim no)
		(at 208.28 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7b488c36-76d7-58e8-99d9-34fd931e99ef")
	)
	(text "An active input lights the LED and pulls\nX1.n low: the expander reads 0 when active.\nD10 to D17 clamp a reversed input to 0.7 V.\nWorst case with all eight inputs on: margin\nat least 3.2 (spec 4.8). LTV-847 pinout\nfrom the stock symbol: 1-8 anode, cathode;\n16 C1, 15 E1 down to 10 C4, 9 E4. To check\nagainst the data sheet."
		(exclude_from_sim no)
		(at 208.28 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e865679c-7240-5ebb-b855-bae66d0c8d2c")
	)
	(text "C40 to C47 not fitted: 24 kOhm x 10 nF\n= 0.24 ms if long cables bring noise."
		(exclude_from_sim no)
		(at 208.28 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "da653014-f6ac-5cd2-89b5-507661b82b4d")
	)
