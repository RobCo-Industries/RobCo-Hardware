	(text "M1 drives the speaker in bridge mode: never tie\nSPK+ or SPK- to GND. 4 to 8 Ohm speaker.\n1 W at 8 Ohm draws about 0.24 A from +5V."
		(exclude_from_sim no)
		(at 190.5 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9d07e528-3fec-5a74-986b-7076cd183015")
	)
	(text "To verify: M1 pin order assumed (1 VIN, 2 GND,\n3 SD, 4 A+, 5 A-, 6 OUT+, 7 OUT-). Take it from\nthe module bought. SD left open: the module\npulls it high (to verify). No stock footprint."
		(exclude_from_sim no)
		(at 190.5 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f28f3f96-5b10-5e66-ace2-142abf57fc72")
	)
