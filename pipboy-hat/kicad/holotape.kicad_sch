	)
	(text "HOLO_BUS high: U4 passes SCLK, MOSI and CS to the card.\nLow or floating: U4 off, R63 and the Pi's reset pull-down.\nU5 drives MISO only while HOLO_BUS is high and CE1 low:\nU4 unit 4 drives BUF_OE, R70 holds it high otherwise.\nU5 runs from +3V3: MISO never rises above the Pi's rail.\nSD_3V3 off: U4 unpowered, Ioff. 33 Ohm at each output.\nParts and pins from memory, TO VERIFY."
		(exclude_from_sim no)
		(at 287.02 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ec3349bf-7901-5d95-95c7-1a7b5bd3b900")
	)
