	(text "VBAT must not float: fit the cell before first power-up,\nor close JP1 with no cell (DS1307 family rule, to verify\nfor the DS1338). A closed JP1 shorts a fitted cell."
		(exclude_from_sim no)
		(at 101.6 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "06d97a5b-ea41-5a98-af15-617c7dab468d")
	)
	(text "Y1: 6 pF load, no capacitors on X1 and X2 (typical, check).\nKeep Y1 within 5 mm of U1, no traces under it.\nU1 pinout as the DS1307 (to verify): 1 X1, 2 X2, 3 VBAT,\n4 GND, 5 SDA, 6 SCL, 7 SQW, 8 VCC. Buy the 3.3 V grade."
		(exclude_from_sim no)
		(at 17.78 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "87095dd3-2117-5d82-b6aa-06aa8f1327ba")
	)
	(text "CR1220: about 35 mAh, under 1 uA from VBAT: about 4 years (typical, check).\nBT1 Keystone 3001 pad polarity: to verify against the holder bought.\nR15 not fitted: SQW is unused. Pip-OS reads the DS1338 at 0x68 as chip=0."
		(exclude_from_sim no)
		(at 17.78 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "214948ab-30bb-5081-824b-8194821d4b76")
	)
