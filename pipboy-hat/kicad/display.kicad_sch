		(uuid "cfa3b317-238e-565b-9ff3-2a2f8799f9c5")
	)
	(text "TFT_BL high: Q2 on, R22 pulls BL_PB down,\nQ1 on: the module's LED pin gets +3V3.\nTFT_BL low: both off, R23 holds Q1 off."
		(exclude_from_sim no)
		(at 160.02 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ef4d1ec0-7082-5344-8d46-8fd441195f06")
	)
	(text "Default on: GPIO 19 is an input with a pull-down\nat reset; R20 wins and the backlight lights.\nPip-OS switches it only with this line in the\n[display] section of PIPOS.CFG: tft_backlight = 19"
		(exclude_from_sim no)
		(at 160.02 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a5f55e1c-7c5c-5a0f-afa5-c156ddd0c6c2")
	)
	(text "To verify: TO-92 pin orders of the stock symbols,\nQ1 BC327: 1 C, 2 B, 3 E. Q2 2N3904: 1 E, 2 B, 3 C."
		(exclude_from_sim no)
		(at 160.02 111.76 0)
		(effects
			(font
